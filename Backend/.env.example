# ==================================================
# Backend Environment Variables — ตัวอย่าง (ไม่ใส่ค่าจริงในไฟล์นี้ และห้าม commit ไฟล์ .env จริง)
# ==================================================
PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/telenursing_prototype_db

# สุ่มด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30m

# โดเมนหน้าเว็บ (คั่นหลายค่าด้วย comma) — Production ต้องเป็น https://โดเมนจริง
FRONTEND_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=12

# Agora (Console → Project → App ID / Primary Certificate)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Web Push (ไม่บังคับ) สร้างด้วย: node src/scripts/generateVapidKeys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
# แสดงตัวอย่างข้อความแชทในการแจ้งเตือนบนหน้าจอล็อก (ค่าเริ่มต้น true) — ตั้ง false เพื่อซ่อนเนื้อหา
# CHAT_PUSH_PREVIEW=true

# อีเมลส่ง OTP (SMTP) — Production บังคับต้องตั้งค่า
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="TeleNursing <no-reply@yourdomain.com>"

# Data Retention (ไม่บังคับ)
# RETENTION_PURGE_ENABLED=true
# RETENTION_PURGE_INTERVAL_MINUTES=60
