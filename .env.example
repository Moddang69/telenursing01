# ไฟล์สำหรับ docker compose (วางไว้ข้าง docker-compose.yml) — คัดลอกเป็น .env แล้วกรอกค่าจริง ห้าม commit
DOMAIN=telenursing.example.com

# MongoDB Atlas (ถ้ารหัสผ่านมีอักขระพิเศษ ให้ใช้รหัสผ่านที่เป็นตัวอักษร+ตัวเลขล้วน หรือ URL-encode)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/telenursing_prod_db?retryWrites=true&w=majority

# สุ่มด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ไม่บังคับ — สร้างด้วย: node src/scripts/generateVapidKeys.js (ในโฟลเดอร์ Backend)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@telenursing.example.com

# SMTP ส่ง OTP
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="TeleNursing <no-reply@telenursing.example.com>"
