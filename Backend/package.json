    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "nodemailer": "^10.5.0",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.4",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "jest": "^25.1.0",
    "mongodb-memory-server": "^9.4.1",
    "nodemon": "^3.1.11",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.0.0"
